# ==============================================================================
# Microsoft Azure AI Vision Service Configuration
# ==============================================================================
# Obtain your Endpoint and Key from the Azure Portal:
# 1. Create an "Azure AI Services" multi-service resource OR a "Computer Vision" single-service resource.
# 2. In the Azure portal resource menu, navigate to "Resource Management" -> "Keys and Endpoint".
# 3. Copy Key 1 (or Key 2) and the Endpoint URL below.
#
# NOTE: Never commit your real .env file or credentials to Git repositories.
# ==============================================================================

AZURE_VISION_ENDPOINT=https://your-resource-name.cognitiveservices.azure.com/
AZURE_VISION_KEY=your_azure_vision_key_here
